generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum UserRole {
  ADMIN
  HR_OFFICER
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum WageType {
  FIXED
}

enum SalaryComponentType {
  FIXED
  PERCENTAGE
  REMAINDER
}

enum PercentageBase {
  WAGE
  BASIC
}

enum SalaryComponentCode {
  BASIC
  HRA
  STANDARD_ALLOWANCE
  PERFORMANCE_BONUS
  LTA
  FIXED_ALLOWANCE
}

enum DeductionType {
  EMPLOYEE_PF
  PROFESSIONAL_TAX
  OTHER
}

enum PayslipLineType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveTypeCode {
  PAID
  SICK
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  RESUME
  CERTIFICATION
  OTHER
}

enum PayslipStatus {
  DRAFT
  GENERATED
  PAID
  CANCELLED
}

/**
 * =========================================================
 * COMPANY
 * =========================================================
 */

model Company {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  email    String?
  phone    String?
  logoUrl  String?
  address  String?
  currency String  @default("INR") @db.VarChar(3)
  timezone String  @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  employees        Employee[]
  departments      Department[]
  jobPositions     JobPosition[]
  skills           Skill[]
  leaveTypes       LeaveType[]
  workingSchedules WorkingSchedule[]
  salaryStructures SalaryStructure[]
  payrollSettings  PayrollSettings?
  payrollRuns      PayrollRun[]

  @@index([name])
}

/**
 * =========================================================
 * AUTHENTICATION / USERS
 * =========================================================
 */

model User {
  id String @id @default(uuid()) @db.Uuid

  companyId  String  @db.Uuid
  employeeId String? @unique @db.Uuid

  email        String @unique
  passwordHash String

  role UserRole @default(EMPLOYEE)

  emailVerifiedAt    DateTime?
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdEmployees Employee[] @relation("EmployeeCreatedBy")

  approvedLeaves LeaveRequest[] @relation("LeaveApprovedBy")

  createdPayslips Payslip[] @relation("PayslipCreatedBy")

  @@index([companyId, role])
  @@index([companyId, isActive])
}

/**
 * =========================================================
 * EMPLOYEE
 * =========================================================
 */

model Employee {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  /**
   * Human-readable employee identifier.
   * Example:
   * OIJODO20220001
   */
  employeeCode String

  /**
   * Login identifier generated by the system.
   */
  loginId String

  firstName String
  lastName  String?

  phone         String?
  personalEmail String?

  dateOfBirth   DateTime?
  gender        Gender?
  nationality   String?
  maritalStatus String?

  profilePictureUrl String?

  about            String?
  jobLove          String?
  interestsHobbies String?

  dateOfJoining DateTime
  dateOfLeaving DateTime?

  address String?

  /**
   * Private information
   */
  panNumber String?
  uanNumber String?

  departmentId  String? @db.Uuid
  jobPositionId String? @db.Uuid

  /**
   * Manager hierarchy
   */
  managerId String? @db.Uuid

  /**
   * Which admin/HR created this employee.
   */
  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * ---------- Relations ----------
   */

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  user User?

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  jobPosition JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  manager Employee? @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)

  directReports Employee[] @relation("EmployeeManager")

  createdBy User? @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  bankDetails BankDetails?

  documents EmployeeDocument[]

  skills EmployeeSkill[]

  certifications Certification[]

  salaryStructure SalaryStructure?

  workingSchedule WorkingSchedule?

  attendances Attendance[]

  leaveAllocations LeaveAllocation[]

  leaveRequests LeaveRequest[] @relation("EmployeeLeaveRequests")

  payslips Payslip[]

  @@unique([companyId, employeeCode])
  @@unique([companyId, loginId])
  @@index([companyId, firstName, lastName])
  @@index([companyId, departmentId])
  @@index([companyId, managerId])
}

/**
 * =========================================================
 * DEPARTMENT
 * =========================================================
 */

model Department {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employees Employee[]

  positions JobPosition[]

  @@unique([companyId, name])
}

/**
 * =========================================================
 * JOB POSITION
 * =========================================================
 */

model JobPosition {
  id           String  @id @default(uuid()) @db.Uuid
  companyId    String  @db.Uuid
  departmentId String? @db.Uuid

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, departmentId])
}

/**
 * =========================================================
 * BANK DETAILS
 * =========================================================
 */

model BankDetails {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @unique @db.Uuid

  accountNumber String
  bankName      String
  ifscCode      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

/**
 * =========================================================
 * SKILLS
 * =========================================================
 */

model Skill {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  name String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employees EmployeeSkill[]

  @@unique([companyId, name])
}

model EmployeeSkill {
  employeeId String @db.Uuid
  skillId    String @db.Uuid

  addedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([employeeId, skillId])
}

/**
 * =========================================================
 * DOCUMENTS
 * =========================================================
 */

model EmployeeDocument {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid

  type      DocumentType
  name      String
  fileUrl   String
  mimeType  String?
  sizeBytes BigInt?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type])
}

/**
 * =========================================================
 * CERTIFICATIONS
 * =========================================================
 */

model Certification {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid

  name      String
  issuer    String?
  issuedAt  DateTime?
  expiresAt DateTime?

  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

/**
 * =========================================================
 * WORKING SCHEDULE
 * =========================================================
 */

model WorkingSchedule {
  id String @id @default(uuid()) @db.Uuid

  companyId  String @db.Uuid
  employeeId String @unique @db.Uuid

  name String

  /**
   * Number of working days in a week.
   * Example: 5
   */
  workingDays Int @default(5)

  /**
   * Stored as HH:mm.
   * Example: "09:00"
   */
  startTime String @default("09:00")
  endTime   String @default("18:00")

  /**
   * Configured break duration.
   */
  breakMinutes Int @default(60)

  weeklyHours Decimal? @db.Decimal(6, 2)

  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/**
 * =========================================================
 * ATTENDANCE
 * =========================================================
 */

model Attendance {
  id String @id @default(uuid()) @db.Uuid

  employeeId String @db.Uuid

  /**
   * One attendance record per employee per calendar day.
   */
  workDate DateTime @db.Date

  checkIn  DateTime?
  checkOut DateTime?

  /**
   * Actual break duration for the day.
   */
  breakMinutes Int @default(0)

  /**
   * Calculated values stored for reporting/payroll.
   */
  workMinutes  Int @default(0)
  extraMinutes Int @default(0)

  status AttendanceStatus @default(ABSENT)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /**
   * Prevent duplicate attendance for the same employee/day.
   */
  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@index([employeeId, workDate])
}

/**
 * =========================================================
 * LEAVE TYPES
 * =========================================================
 */

model LeaveType {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  code LeaveTypeCode
  name String

  /**
   * Default yearly allocation.
   */
  defaultDays Decimal? @db.Decimal(6, 2)

  /**
   * Sick leave can require a certificate.
   */
  requiresProof Boolean @default(false)

  isPaid   Boolean
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  allocations LeaveAllocation[]

  requests LeaveRequest[]

  @@unique([companyId, code])
}

/**
 * =========================================================
 * LEAVE ALLOCATION
 * =========================================================
 */

model LeaveAllocation {
  id String @id @default(uuid()) @db.Uuid

  employeeId  String @db.Uuid
  leaveTypeId String @db.Uuid

  year Int

  allocatedDays Decimal @default(0) @db.Decimal(8, 2)
  usedDays      Decimal @default(0) @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

/**
 * =========================================================
 * LEAVE REQUEST
 * =========================================================
 */

model LeaveRequest {
  id String @id @default(uuid()) @db.Uuid

  employeeId  String @db.Uuid
  leaveTypeId String @db.Uuid

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /**
   * Stored because leave can later support half-days.
   */
  requestedDays Decimal @db.Decimal(6, 2)

  reason String?

  status LeaveRequestStatus @default(PENDING)

  reviewerComment String?

  /**
   * Especially useful for sick leave certificates.
   */
  attachmentUrl  String?
  attachmentName String?

  submittedAt DateTime @default(now())

  reviewedAt DateTime?

  approvedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  approvedBy User? @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId, startDate, endDate])
  @@index([status, startDate])
  @@index([leaveTypeId])
}

/**
 * =========================================================
 * SALARY STRUCTURE
 * =========================================================
 */

model SalaryStructure {
  id String @id @default(uuid()) @db.Uuid

  companyId  String @db.Uuid
  employeeId String @unique @db.Uuid

  wageType WageType @default(FIXED)

  /**
   * Main salary input.
   * Example:
   * ₹50,000 / month
   */
  monthlyWage Decimal @db.Decimal(14, 2)

  currency String @default("INR") @db.VarChar(3)

  /**
   * PF rates.
   * Example:
   * Employee = 12%
   * Employer = 12%
   */
  employeePfRate Decimal @default(12) @db.Decimal(5, 2)
  employerPfRate Decimal @default(12) @db.Decimal(5, 2)

  /**
   * Professional Tax.
   * Example:
   * ₹200 / month
   */
  professionalTax Decimal @default(200) @db.Decimal(12, 2)

  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  components SalaryComponent[]

  @@index([companyId])
}

/**
 * =========================================================
 * SALARY COMPONENTS
 * =========================================================
 */

model SalaryComponent {
  id String @id @default(uuid()) @db.Uuid

  salaryStructureId String @db.Uuid

  code SalaryComponentCode

  name String

  /**
   * FIXED:
   * fixedAmount is used.
   * PERCENTAGE:
   * percentage + percentageBase are used.
   * REMAINDER:
   * amount = wage - all previous components.
   */
  computationType SalaryComponentType

  /**
   * Relevant only when computationType = PERCENTAGE.
   * WAGE:
   * percentage of monthly wage.
   * BASIC:
   * percentage of calculated Basic salary.
   */
  percentageBase PercentageBase?

  /**
   * Example:
   * 50.00
   * 8.33
   */
  percentage Decimal? @db.Decimal(7, 4)

  /**
   * Example:
   * Standard Allowance = ₹4,167
   */
  fixedAmount Decimal? @db.Decimal(14, 2)

  /**
   * Calculation order.
   * Basic first,
   * HRA after Basic,
   * etc.
   */
  sequence Int @default(0)

  isEarning Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@unique([salaryStructureId, code])
  @@index([salaryStructureId, sequence])
}

/**
 * =========================================================
 * COMPANY PAYROLL DEFAULTS
 * =========================================================
 */

model PayrollSettings {
  id String @id @default(uuid()) @db.Uuid

  companyId String @unique @db.Uuid

  defaultEmployeePfRate Decimal @default(12) @db.Decimal(5, 2)
  defaultEmployerPfRate Decimal @default(12) @db.Decimal(5, 2)

  defaultProfessionalTax Decimal @default(200) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/**
 * =========================================================
 * PAYROLL RUN
 * =========================================================
 */

model PayrollRun {
  id String @id @default(uuid()) @db.Uuid

  companyId String @db.Uuid

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  status PayslipStatus @default(DRAFT)

  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  payslips Payslip[]

  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId, periodStart, periodEnd])
}

/**
 * =========================================================
 * PAYSLIP
 * =========================================================
 */

model Payslip {
  id String @id @default(uuid()) @db.Uuid

  payrollRunId String @db.Uuid
  employeeId   String @db.Uuid

  createdById String? @db.Uuid

  status PayslipStatus @default(GENERATED)

  currency String @default("INR") @db.VarChar(3)

  /**
   * Snapshot of salary at payroll generation time.
   */
  monthlyWage Decimal @db.Decimal(14, 2)

  /**
   * Attendance/payroll snapshot.
   */
  payableDays Decimal @db.Decimal(8, 2)
  unpaidDays  Decimal @db.Decimal(8, 2)

  grossSalary Decimal @db.Decimal(14, 2)

  /**
   * Employee-side deductions.
   */
  employeePf      Decimal @db.Decimal(14, 2)
  professionalTax Decimal @db.Decimal(14, 2)
  otherDeductions Decimal @default(0) @db.Decimal(14, 2)

  totalDeductions Decimal @db.Decimal(14, 2)

  netSalary Decimal @db.Decimal(14, 2)

  /**
   * Employer PF is not deducted from employee net salary.
   * It is stored separately.
   */
  employerPf Decimal @db.Decimal(14, 2)

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  createdBy User? @relation("PayslipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines PayslipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId, generatedAt])
}

/**
 * =========================================================
 * PAYSLIP LINES
 * =========================================================
 */

model PayslipLine {
  id String @id @default(uuid()) @db.Uuid

  payslipId String @db.Uuid

  code String
  name String

  type PayslipLineType

  amount Decimal @db.Decimal(14, 2)

  sequence Int @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([payslipId, sequence])
}
